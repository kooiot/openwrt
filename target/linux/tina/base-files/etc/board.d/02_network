. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

tina_setup_interfaces()
{
	local board="$1"

	case "$board" in
	kooiot,tlink-t536|\
	kooiot,tlink-t536-1)
		ucidef_set_interfaces_lan_wan "eth0" "eth1"
		;;
	*)
		ucidef_set_interface_lan "eth0"
		;;
	esac
}

tina_setup_macs()
{
	local board="$1"
	local lan_mac=""
	local wan_mac=""
	local label_mac=""

	case "$board" in
	kooiot,tlink-t536|\
	kooiot,tlink-t536-1)
		# lan_mac=$(get_mac_binary "/sys/bus/i2c/devices/0-0050/eeprom" 0x20)
		# wan_mac=$(macaddr_add $(get_mac_binary "/sys/bus/i2c/devices/0-0050/eeprom" 0x20) 1)
		;;
	esac

	[ -n "$lan_mac" ] && ucidef_set_interface_macaddr "lan" $lan_mac
	[ -n "$wan_mac" ] && ucidef_set_interface_macaddr "wan" $wan_mac
	[ -n "$label_mac" ] && ucidef_set_label_macaddr $label_mac
}

board_config_update
board=$(board_name)
tina_setup_interfaces $board
tina_setup_macs $board
board_config_flush

exit 0
