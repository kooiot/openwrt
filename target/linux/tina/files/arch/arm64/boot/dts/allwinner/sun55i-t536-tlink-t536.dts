#include <dt-bindings/input/input.h>
#include "t536-board.dtsi"
#include "rp-pmic-axp.dtsi"
#include "rp-sdcard-mmc0.dtsi"
// #include "rp-audio-es8388.dtsi"
// #include "rp-bt-sco-codec.dtsi"
// #include "rp-pcie-m2.dtsi"
// #include "rp-wifi-sdio-mmc1.dtsi"
// #include "rp-gmac0-1000m.dtsi"
// #include "rp-gmac1-1000m.dtsi"

// #include "rp-lcd-duallvds-21-1920x1080.dtsi"
// #include "rp-lcd-lvds-10-1024x600.dtsi"
// #include "rp-lcd-mipi-10.1-1920x1200.dtsi"
// #include "rp-lcd-mipi-10.1-1200x1920.dtsi"
// #include "rp-lcd-mipi-10.1-800x1280.dtsi"
// #include "rp-lcd-mipi-8-1200x1920.dtsi"
// #include "rp-lcd-mipi-8-800x1280.dtsi"
// #include "rp-lcd-mipi-7-1200x1920.dtsi"
// #include "rp-lcd-mipi-7-720x1280.dtsi"
// #include "rp-lcd-mipi-7-1024x600.dtsi"
// #include "rp-lcd-mipi-5.5-720x1280.dtsi"
// #include "rp-lcd-mipi-5-720x1280.dtsi"

// #include "rp-lcd-gpio.dtsi"

/delete-node/ &rgb_panel0;
/delete-node/ &rgb0;
/delete-node/ &lcd0;
/delete-node/ &lvds0;
/delete-node/ &de;
/delete-node/ &dsi0;
/delete-node/ &ledc;
/delete-node/ &ledc_pins_active;
/delete-node/ &ledc_pins_sleep;

/{
    board = "tlink-t536";
    model = "tlink-t536";
	compatible = "kooiot,tlink-t536", "arm,sun55iw6p1";

    /* bluetooth uart use /dev/ttyAS1 */
    bt_uart_idx = "1"; 

	aliases {
		serial0 = &uart0;
		mmc0 = &sdc0;
		mmc1 = &sdc2;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		/*
		serial1 = &uart9;
		serial2 = &uart10;
		serial3 = &uart11;
		serial4 = &uart14;
		serial5 = &uart1;
		serial6 = &uart2;
		serial7 = &uart3;
		serial8 = &uart4;
		serial9 = &uart6;
		serial10 = &uart8;
		*/
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		status {
			label = "kooiot:green:status";
            gpios = <&r_pio PL 4 GPIO_ACTIVE_HIGH>; /* PL4 */
			linux,default-trigger = "heartbeat";
		};

		pcie_pwr {
			label = "kooiot:green:pcie_power";
			gpios = <&pio PA 1 GPIO_ACTIVE_HIGH>; /* PA1 */
			default-state = "off";
		};
	};

	gpio_keys {
		compatible = "gpio-keys-polled";
		poll-interval = <20>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio PH 10 GPIO_ACTIVE_LOW>; /* PH10 */
		};
	};

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		pcie_power {
			gpio-export,name = "pcie_power";
			gpio-export,output=<1>;
			gpios = <&pio 8 4 GPIO_ACTIVE_HIGH>; /* PI4 */
		};

		pcie_reset {
			gpio-export,name = "pcie_reset";
			gpio-export,output=<1>;
			gpios = <&pio PL 12 GPIO_ACTIVE_HIGH>; /* PL12 */
		};

		pcie_on_off {
			gpio-export,name = "pcie_on_off";
			gpio-export,output=<1>;
			gpios = <&pio PA 0 GPIO_ACTIVE_HIGH>; /* PA0 */
		};

		pcie_disable {
			gpio-export,name = "pcie_disable";
			gpio-export,output=<1>;
			gpios = <&pio PA 2 GPIO_ACTIVE_HIGH>; /* PA2 */
		};

		pcie_card_power_off {
			gpio-export,name = "pcie_card_power_off";
			gpio-export,output=<1>;
			gpios = <&pio PL 11 GPIO_ACTIVE_HIGH>; /* PL11 */
		};

		pcie20_enable {
			gpio-export,name = "pcie20_enable";
			gpio-export,output=<0>;  /* or will be USB3.0 */
			gpios = <&pio PL 13 GPIO_ACTIVE_LOW>; /* PL13 */
		};
	};

	watchdog {
		compatible = "linux,wdt-gpio";
		vcc-supply=<&wdt_en>;
		gpios = <&pio PA 7 GPIO_ACTIVE_HIGH>; /* PA7 */
		hw_algo = "toggle";
		hw_margin_ms = <200>;
		always-running;
	};

	/* watchdog enable pin */
	wdt_en: fixedregulator@0 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-boot-on;
		regulator-name = "wdt_en";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&pio PA 6 GPIO_ACTIVE_LOW>; /* PA6 */
		startup-delay-us=<3000000>; // 3 seconds
	};
};

&sunxi_drm {
    status = "disabled";
};

&can0 {
    status = "okay";
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&can0_pins_a>;
    pinctrl-1 = <&can0_pins_b>;
};

&can1 {
    status = "okay";
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&can1_pins_a>;
    pinctrl-1 = <&can1_pins_b>;
};

&can1_pins_a {
	pins = "PD8", "PD9";
	function = "can1";
};

&can1_pins_b {
	pins = "PD8", "PD9";
	function = "io_disabled";
};

&can2 {
    status = "okay";
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&can2_pins_a>;
    pinctrl-1 = <&can2_pins_b>;
};

&can3 {
    status = "okay";
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&can3_pins_a>;
    pinctrl-1 = <&can3_pins_b>;
};

&uart1_pins_a {
	pins = "PG6", "PG7";
};

&uart1_pins_b {
	pins = "PG6", "PG7";
};

&uart1 {
    status = "okay";
	uart1_type = <2>;
	uart1_port = <10>;
};

&uart2_pins_a {
    pins = "PD20", "PD21";
};

&uart2_pins_b {
    pins = "PD20", "PD21";
};

&uart2 {
    status = "okay";
	uart2_type = <2>;
	uart2_port = <11>;
};

&uart3_pins_a {
    pins = "PD14", "PD15";
};

&uart3_pins_b {
    pins = "PD14", "PD15";
};

&uart3 {
    status = "okay";
	uart3_type = <2>;
	uart3_port = <12>;
};

&uart4_pins_a {
    pins = "PI13", "PI14";
};

&uart4_pins_b {
    pins = "PI13", "PI14";
};

&uart4 {
    status = "okay";
	uart4_type = <2>;
	uart4_port = <13>;
};

&uart6 {
    status = "okay";
	uart6_type = <2>;
	uart6_port = <14>;
};

&uart8 {
    status = "okay";
	uart8_type = <2>;
	uart8_port = <15>;
};

&uart9_pins_a {
    pins = "PD0", "PD1";
};

&uart9_pins_b {
    pins = "PD0", "PD1";
};

&uart9 {
    status = "okay";
	uart9_type = <2>;
	uart9_port = <1>;
};

&uart10_pins_a {
    pins = "PD4", "PD5";
};

&uart10_pins_b {
    pins = "PD4", "PD5";
};

&uart10 {
    status = "okay";
	uart10_type = <2>;
	uart10_port = <2>;
};

&uart11_pins_a {
    pins = "PH12", "PH13";
};

&uart11_pins_b {
    pins = "PH12", "PH13";
};

&uart11 {
    status = "okay";
	uart11_type = <2>;
	uart11_port = <3>;
};

&uart14_pins_a {
    pins = "PG10", "PG11";
};

&uart14_pins_b {
    pins = "PG10", "PG11";
};

&uart14 {
    status = "okay";
	uart14_type = <2>;
	uart14_port = <4>;
};

&can0 {
    status = "okay";
};

&can1_pins_a {
	pins = "PD8", "PD9";
};

&can1_pins_b {
	pins = "PD8", "PD9";
};

&can1 {
    status = "okay";
};

&can2 {
    status = "okay";
};

&can3 {
    status = "okay";
};

&twi2 {
    status = "disabled";
};

&twi5 {
    status = "disabled";
};

&twi3 {
    status = "disabled";
};

/* twi-8 */
&s_twi1 {
    status = "disabled";
};

&twi6_pins_default {
	pins = "PD18", "PD19";
};

&twi6_pins_sleep {
	pins = "PD18", "PD19";
};

&twi6 {
	status = "okay";

	sd3077: sd3077@32 {
		compatible = "whwave,sd3078";
		reg = <0x32>;
		status = "okay";
	};

	at24c02: eeprom@50 {
		compatible = "atmel,24c02";
		reg = <0x50>;
		pagesize = <16>;
	};
};

&gpadc0 {
    status = "disabled";
};

&gpadc0 {
    status = "disabled";
};

&pio {
    rp_gpio_pins:rp_gpio_pins {
        pins = "PC7";
        function="gpio_out";
    };
};

&r_pio {
    rp_gpio_pins_r:rp_gpio_pins_r {
        pins = "PL4";
        function="gpio_out";
    };
};

&sdc2 {
    status = "okay";
};

&gmac0 {
	status = "okay";
	pinctrl-names = "default";
	//pinctrl-names = "default", "sleep";
	pinctrl-0 = <&gmac0_pins_default>;
	//pinctrl-1 = <&gmac0_pins_sleep>;
	gmac-power0-supply = <&reg_cldo3>;
	gmac-power1-supply;
	gmac-power2-supply;
	gmac-power0-vol = <3300000>;
	gmac-power1-vol;
	gmac-power2-vol;

    sunxi,phy-clk-type = <1>; // 0:External phy use phy25m clk provided by Soc, 1: External phy use extern osc 25m
    tx-delay = <5>;
    rx-delay = <12>;
    /delete-property/ aw,rgmii-clk-ext;
	/delete-property/ phy-handle;
	aw,soc-phy25m;
	// /delete-property/ aw,soc-phy25m;

	//snps,reset-gpio = <&pio PA 3 GPIO_ACTIVE_LOW>; /* PA3 */
	//snps,reset-delays-us = <0 20000 200000>;

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&mdio0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	/delete-node/ ethernet-phy@1;

	switch@1d {
		compatible = "motorcomm,yt9215";
		/* default 0x1d, alternate 0x0 */
		reg = <0x1d>;
		reset-gpios = <&pio PA 3 GPIO_ACTIVE_LOW>; /* PA3 */
		reset-delay-us = <20000>;
		reset-post-delay-us = <200000>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw0_phy1: phy@1 {
				reg = <0x1>;
			};

			sw0_phy3: phy@3 {
				reg = <0x3>;
			};
		};

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan1";
				phy-mode = "internal";
				phy-handle = <&sw0_phy1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan2";
				phy-mode = "internal";
				phy-handle = <&sw0_phy3>;
			};

			/* CPU port */
			ethernet-port@8 {
				reg = <8>;
				label = "cpu";
				phy-mode = "1000base-x";
				ethernet = <&gmac0>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};
};


&gmac1 {
    status = "disabled";
    phy-mode = "rgmii";
    pinctrl-names = "default", "sleep";
    pinctrl-0 = <&gmac1_pins_default>;
    pinctrl-1 = <&gmac1_pins_sleep>;
    sunxi,phy-clk-type = <1>; // 0:External phy use phy25m clk provided by Soc, 1: External phy use extern osc 25m
    //tx-delay = <10>;
    //rx-delay = <12>;
    /delete-property/ aw,rgmii-clk-ext;
	/delete-property/ phy-handle;

	// snps,reset-gpio = <&pio 0 3 GPIO_ACTIVE_LOW>; /* PA4 */
	// snps,reset-delays-us = <0 10000 1000000>;

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&mdio1 {
    status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	/delete-node/ ethernet-phy@1;

	switch@1d {
		compatible = "motorcomm,yt9215";
		/* default 0x1d, alternate 0x0 */
		reg = <0x1d>;
		reset-gpios = <&pio PA 4 GPIO_ACTIVE_LOW>; /* PA4 */
		reset-delay-us = <20000>;
		reset-post-delay-us = <200000>;

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			sw1_phy1: phy@1 {
				reg = <0x1>;
			};

			sw1_phy3: phy@3 {
				reg = <0x3>;
			};
		};

		ethernet-ports {
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet-port@1 {
				reg = <1>;
				label = "lan3";
				phy-mode = "internal";
				phy-handle = <&sw1_phy1>;
			};

			ethernet-port@3 {
				reg = <3>;
				label = "lan4";
				phy-mode = "internal";
				phy-handle = <&sw1_phy3>;
			};

			/* CPU port */
			ethernet-port@8 {
				reg = <8>;
				label = "cpu";
				phy-mode = "1000base-x";
				ethernet = <&gmac1>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};
	};

};
