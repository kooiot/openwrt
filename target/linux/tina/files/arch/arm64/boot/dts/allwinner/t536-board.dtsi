/dts-v1/;

#include "sun55iw6p1.dtsi"

/{
	board = "T536", "T536-DEMO";
	compatible = "allwinner,t536", "arm,sun55iw6p1";
	aliases {
		pmu0 = &pmu0;
		standby_param = &standby_param;
		arisc-config = &arisc_config;
	};

	standby_param: standby_param {
		vdd-cpu = <0x00000001>;
		vdd-sys = <0x00000002>;
		vcc-pll = <0x00000080>;
		vcc-io  = <0x00004000>;
		osc24m-on = <0x0>;
		mcu-standby-en = <0x0>;
	};

	arisc_config: arisc_config {
		s_uart_config{
			pins = "PL2", "PL3";
			function = <2>, <2>;
			status = "disabled";
		};
	};

	vdd_sys_consumer: vdd_sys_consumer {
		compatible = "allwinner,virtual_consumer_regulator";
		power-supply = <&reg_dcdc2>;
	};

	reserved-memory {
		rv_sram_reserved: riscvsram0@40000 {
			reg = <0x0 0x00040000 0x0 0x0002BFFF>;
			no-map;
			sleep-data-loss;
		};

		e907_mem_fw: e907_mem_fw@46000000 {
			/* boot0 & uboot0 load elf addr */
			reg = <0x0 0x46000000 0x0 0x00200000>;
		};

		e907_dram_reserved: e907_dram@60000000 {
			reg = <0x0 0x60000000 0x0 0x00100000>;
			no-map;
		};

		e907_rpbuf_reserved: e907_rpbuf@42380000 {
			compatible = "shared-dma-pool";
			no-map;
			reg = <0x0 0x42380000 0x0 0x80000>;
		};
		/*
		 * The name should be "vdev%dbuffer".
		 * Its size should be not less than
		 *     RPMSG_BUF_SIZE * (num of buffers in a vring) * 2
		 *   = 512 * (num of buffers in a vring) * 2
		 */
		rv_vdev0buffer: vdev0buffer@42400000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x42400000 0x0 0x40000>;
			no-map;
		};

		/*
		 * The name should be "vdev%dvring%d".
		 * The size of each should be not less than
		 *     PAGE_ALIGN(vring_size(num, align))
		 *   = PAGE_ALIGN(16 * num + 6 + 2 * num + (pads for align) + 6 + 8 * num)
		 *
		 * (Please refer to the vring layout in include/uapi/linux/virtio_ring.h)
		 */
		rv_vdev0vring0: vdev0vring0@42440000 {
			reg = <0x0 0x42440000 0x0 0x2000>;
			no-map;
		};
		rv_vdev0vring1: vdev0vring1@42442000 {
			reg = <0x0 0x42442000 0x0 0x2000>;
			no-map;
		};

		/*
		 * The name should be "vdev%dbuffer".
		 * Its size should be not less than
		 *     RPMSG_BUF_SIZE * (num of buffers in a vring) * 2
		 *   = 512 * (num of buffers in a vring) * 2
		 */
		a55_vdev0buffer: vdev0buffer@42444000 {
			compatible = "shared-dma-pool";
			reg = <0x0 0x42444000 0x0 0x40000>;
			no-map;
		};

		/*
		 * The name should be "vdev%dvring%d".
		 * The size of each should be not less than
		 *     PAGE_ALIGN(vring_size(num, align))
		 *   = PAGE_ALIGN(16 * num + 6 + 2 * num + (pads for align) + 6 + 8 * num)
		 *
		 * (Please refer to the vring layout in include/uapi/linux/virtio_ring.h)
		 */
		a55_vdev0vring0: vdev0vring0@42484000 {
			reg = <0x0 0x42484000 0x0 0x2000>;
			no-map;
		};
		a55_vdev0vring1: vdev0vring1@42484000 {
			reg = <0x0 0x42486000 0x0 0x2000>;
			no-map;
		};

		a55_reserved: a55_ddr@49000000 {
			reg = <0x0 0x49000000 0x0 0x00a00000>;
			no-map;
		};

		e907_share_irq_table: share_irq_table@42488000 {
			reg = <0x0 0x42488000 0x0 0x1000>;
			no-map;
		};
	};

	rpbuf_controller0: rpbuf_controller@0 {
		compatible = "allwinner,rpbuf-controller";
		remoteproc = <&e907_rproc>;
		ctrl_id = <0>;
		memory-region = <&e907_rpbuf_reserved>;
		status = "okay";
	};

	reserved-irq {
		share-e907 {
			arch-name = "e907";
			memory-region = <&e907_share_irq_table>;
			/* defined by sun55iw6-share-irq-dt.h */
			share-irq =
					<1    0x1    E907_PA_IRQ_NUM    ARM_PA_IRQ_NUM    0x00000000>,
					<2    0x2    E907_PB_IRQ_NUM    ARM_PB_IRQ_NUM    0x00000000>,
					<3    0x3    E907_PC_IRQ_NUM    ARM_PC_IRQ_NUM    0x00000000>,
					<4    0x4    E907_PD_IRQ_NUM    ARM_PD_IRQ_NUM    0x00000000>,
					<5    0x5    E907_PE_IRQ_NUM    ARM_PE_IRQ_NUM    0x00000000>,
					<6    0x6    E907_PF_IRQ_NUM    ARM_PF_IRQ_NUM    0x00000000>,
					<7    0x7    E907_PG_IRQ_NUM    ARM_PG_IRQ_NUM    0x00000000>,
					<8    0x8    E907_PH_IRQ_NUM    ARM_PH_IRQ_NUM    0x00000000>,
					<9    0x9    E907_PI_IRQ_NUM    ARM_PI_IRQ_NUM    0x00000000>,
					<10   0xa    E907_PJ_IRQ_NUM    ARM_PJ_IRQ_NUM    0x00000000>,
					<11   0xb    E907_PK_IRQ_NUM    ARM_PK_IRQ_NUM    0x00000000>,
					<12   0xc    E907_PL_IRQ_NUM    ARM_PL_IRQ_NUM    0x00000000>,
					<13   0xd    E907_PM_IRQ_NUM    ARM_PM_IRQ_NUM    0x00000000>;
		};
	};

	reg_usb0_vbus: usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb0-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1000>;
		gpio = <&r_pio PL 12 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_usb1_vbus: usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-enable-ramp-delay = <1000>;
		gpio = <&r_pio PL 13 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	rgb_panel0: rgb_panel@1 {
		compatible = "sunxi-rgb";
		status = "disabled";
		reg = <0>;
		power0-supply = <&reg_dcdc4>;
		power1-supply = <&reg_cldo1>;
		backlight = <&backlight0>;
		display-timings {
			native-mode = <&rgb0_timing0>;
			rgb0_timing0: timing0 {
				clock-frequency = <48360000>;
				hback-porch = <35>;
				hactive = <1024>;
				hfront-porch = <161>;
				hsync-len = <20>;
				vback-porch = <25>;
				vactive = <600>;
				vfront-porch = <15>;
				vsync-len = <10>;
			};
		};
		port {
			rgb0_panel_in: endpoint {
				remote-endpoint = <&rgb0_panel_out>;
			};
		};
	};

	can0: can@0x0453C800 {
			compatible = "allwinner,sun55i-t536-can";
			reg = <0x0 0x0453C800 0x0 0x400>,
				<0x0 0x04538000 0x0 0x4400>,
				<0x0 0x04530000 0x0 0x1000>,
				<0x0 0x04534000 0x0 0x1000>;
			reg-names = "can", "message_ram", "can_top", "can_dma";
			interrupts = <GIC_SPI 36 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 35 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "int0", "int_top", "int1";
			clocks = <&ccu CLK_CAN0>, <&ccu CLK_BUS_CAN0>, <&ccu CLK_MBUS_CAN_GATE>;
			clock-names = "can_clk", "can_bus", "can_mbus";
			resets = <&ccu RST_BUS_CAN0>;
			reset-names = "can_rst";
			clock-frequency = <40000000>;
			allwinner,ram-cfg = <0x0 0 0 64 64 64 32 32>;
			status = "disable";
	};

	can1: can@0x04541800 {
		compatible = "allwinner,sun55i-t536-can";
		reg = <0x0 0x04541800 0x0 0x400>,
			<0x0 0x0453D000 0x0 0x4400>,
			<0x0 0x04531000 0x0 0x1000>,
			<0x0 0x04535000 0x0 0x1000>;
		reg-names = "can", "message_ram", "can_top", "can_dma";
		interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "int0", "int_top", "int1";
		clocks = <&ccu CLK_CAN1>, <&ccu CLK_BUS_CAN1>, <&ccu CLK_MBUS_CAN_GATE>;
		clock-names = "can_clk", "can_bus", "can_mbus";
		resets = <&ccu RST_BUS_CAN1>;
		reset-names = "can_rst";
		clock-frequency = <40000000>;
		allwinner,ram-cfg = <0x0 0 0 64 64 64 32 32>;
		status = "disable";
	};

	can2: can@0x04546800 {
		compatible = "allwinner,sun55i-t536-can";
		reg = <0x0 0x04546800 0x0 0x400>,
			<0x0 0x04542000 0x0 0x4400>,
			<0x0 0x04532000 0x0 0x1000>,
			<0x0 0x04536000 0x0 0x1000>;
		reg-names = "can", "message_ram", "can_top", "can_dma";
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 108 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 110 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "int0", "int_top", "int1";
		clocks = <&ccu CLK_CAN2>, <&ccu CLK_BUS_CAN2>, <&ccu CLK_MBUS_CAN_GATE>;
		clock-names = "can_clk", "can_bus", "can_mbus";
		resets = <&ccu RST_BUS_CAN2>;
		reset-names = "can_rst";
		clock-frequency = <40000000>;
		allwinner,ram-cfg = <0x0 0 0 64 64 64 32 32>;
		status = "disable";
	};

	can3: can@0x0454B800 {
		compatible = "allwinner,sun55i-t536-can";
		reg = <0x0 0x0454B800 0x0 0x400>,
			<0x0 0x04547000 0x0 0x4400>,
			<0x0 0x04533000 0x0 0x1000>,
			<0x0 0x04537000 0x0 0x1000>;
		reg-names = "can", "message_ram", "can_top", "can_dma";
		interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 111 IRQ_TYPE_LEVEL_HIGH>, <GIC_SPI 37 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "int0", "int_top", "int1";
		clocks = <&ccu CLK_CAN3>, <&ccu CLK_BUS_CAN3>, <&ccu CLK_MBUS_CAN_GATE>;
		clock-names = "can_clk", "can_bus", "can_mbus";
		resets = <&ccu RST_BUS_CAN3>;
		reset-names = "can_rst";
		clock-frequency = <40000000>;
		allwinner,ram-cfg = <0x0 0 0 64 64 64 32 32>;
		status = "disable";
	};
};

&pio {
	uart0_pins_a: uart0_pins@0 {
		pins = "PB9", "PB10";
		function = "uart0";
		bias-pull-up;
	};

	uart0_pins_b: uart0_pins@1 {
		pins = "PB9", "PB10";
		function = "io_disabled";
	};

	uart1_pins_a: uart1_pins@0 {
		pins = "PG6", "PG7", "PG8", "PG9";
		function = "uart1";
		bias-pull-up;
	};

	uart1_pins_b: uart1_pins@1 {
		pins = "PG6", "PG7", "PG8", "PG9";
		function = "io_disabled";
	};

	uart2_pins_a: uart2_pins@0 {
		pins = "PB0", "PB1", "PB2", "PB3";
		function = "uart2";
		bias-pull-up;
	};

	uart2_pins_b: uart2_pins@1 {
		pins = "PB0", "PB1", "PB2", "PB3";
		function = "io_disabled";
	};

	uart3_pins_a: uart3_pins@0 {
		pins = "PH4", "PH5", "PH6", "PH7";
		function = "uart3";
		bias-pull-up;
	};

	uart3_pins_b: uart3_pins@1 {
		pins = "PH4", "PH5", "PH6", "PH7";
		function = "io_disabled";
	};

	uart4_pins_a: uart4_pins@0 {
		pins = "PI13", "PI14", "PI15", "PI16";
		function = "uart4";
		bias-pull-up;
	};

	uart4_pins_b: uart4_pins@1 {
		pins = "PI13", "PI14", "PI15", "PI16";
		function = "io_disabled";
	};

	uart5_pins_a: uart5_pins@0 {
		pins = "PK14", "PK15", "PK16", "PK17";
		function = "uart5";
		bias-pull-up;
	};

	uart5_pins_b: uart5_pins@1 {
		pins = "PK14", "PK15", "PK16", "PK17";
		function = "io_disabled";
	};

	uart6_pins_a: uart6_pins@0 {
		pins = "PI6", "PI7";
		function = "uart6";
		bias-pull-up;
	};

	uart6_pins_b: uart6_pins@1 {
		pins = "PI6", "PI7";
		function = "io_disabled";
	};

	uart7_pins_a: uart7_pins@0 {
		pins = "PB13", "PB14", "PB15", "PB16";
		function = "uart7";
		bias-pull-up;
	};

	uart7_pins_b: uart7_pins@1 {
		pins = "PB13", "PB14", "PB15", "PB16";
		function = "io_disabled";
	};

	uart8_pins_a: uart8_pins@0 {
		pins = "PB4", "PB5";
		function = "uart8";
		bias-pull-up;
	};

	uart8_pins_b: uart8_pins@1 {
		pins = "PB4", "PB5";
		function = "io_disabled";
	};

	uart9_pins_a: uart9_pins@0 {
		pins = "PI2", "PI3", "PI4", "PI5";
		function = "uart9";
		bias-pull-up;
	};

	uart9_pins_b: uart9_pins@1 {
		pins = "PI2", "PI3", "PI4", "PI5";
		function = "io_disabled";
	};

	uart10_pins_a: uart10_pins@0 {
		pins = "PJ12", "PJ13", "PJ14", "PJ15";
		function = "uart10";
		bias-pull-up;
	};

	uart10_pins_b: uart10_pins@1 {
		pins = "PJ12", "PJ13", "PJ14", "PJ15";
		function = "io_disabled";
	};

	uart11_pins_a: uart11_pins@0 {
		pins = "PK0", "PK1", "PK2", "PK3";
		function = "uart11";
		bias-pull-up;
	};

	uart11_pins_b: uart11_pins@1 {
		pins = "PK0", "PK1", "PK2", "PK3";
		function = "io_disabled";
	};

	uart12_pins_a: uart12_pins@0 {
		pins = "PK4", "PK5", "PK6", "PK7";
		function = "uart12";
		bias-pull-up;
	};

	uart12_pins_b: uart12_pins@1 {
		pins = "PK4", "PK5", "PK6", "PK7";
		function = "io_disabled";
	};

	uart13_pins_a: uart13_pins@0 {
		pins = "PG0", "PG1", "PG2", "PG3";
		function = "uart13";
		bias-pull-up;
	};

	uart13_pins_b: uart13_pins@1 {
		pins = "PG0", "PG1", "PG2", "PG3";
		function = "io_disabled";
	};

	uart14_pins_a: uart14_pins@0 {
		pins = "PG10", "PG11", "PG12", "PG13";
		function = "uart14";
		bias-pull-up;
	};

	uart14_pins_b: uart14_pins@1 {
		pins = "PG10", "PG11", "PG12", "PG13";
		function = "io_disabled";
	};

	can0_pins_a: can0_pins@0 {
		pins = "PI0", "PI1";
		function = "can0";
	};

	can0_pins_b: can0_pins@1 {
		pins = "PI0", "PI1";
		function = "io_disabled";
	};

	can1_pins_a: can1_pins@0 {
		pins = "PB7", "PB8";
		function = "can1";
	};

	can1_pins_b: can1_pins@1 {
		pins = "PB7", "PB8";
		function = "io_disabled";
	};

	can2_pins_a: can2_pins@0 {
		pins = "PI8", "PI9";
		function = "can2";
	};

	can2_pins_b: can2_pins@1 {
		pins = "PI8", "PI9";
		function = "io_disabled";
	};

	can3_pins_a: can3_pins@0 {
		pins = "PI2", "PI3";
		function = "can3";
	};

	can3_pins_b: can3_pins@1 {
		pins = "PI2", "PI3";
		function = "io_disabled";
	};

	twi0_pins_default: twi0@0 {
		pins = "PD22", "PD23";
		function = "twi0";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi0_pins_sleep: twi0@1 {
		pins = "PD22", "PD23";
		function = "gpio_in";
	};

	twi1_pins_default: twi1@0 {
		pins = "PE11", "PE12";
		function = "twi1";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi1_pins_sleep: twi1@1 {
		pins = "PE11", "PE12";
		function = "gpio_in";
	};

	twi2_pins_default: twi2@0 {
		pins = "PE1", "PE2";
		function = "twi2";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi2_pins_sleep: twi2@1 {
		pins = "PE1", "PE2";
		function = "gpio_in";
	};

	twi3_pins_default: twi3@0 {
		pins = "PI11", "PI12";
		function = "twi3";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi3_pins_sleep: twi3@1 {
		pins = "PI11", "PI12";
		function = "gpio_in";
	};

	twi4_pins_default: twi4@0 {
		pins = "PJ24", "PJ25";
		function = "twi4";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi4_pins_sleep: twi4@1 {
		pins = "PJ24", "PJ25";
		function = "gpio_in";
	};

	twi5_pins_default: twi5@0 {
		pins = "PI4", "PI5";
		function = "twi5";
		drive-strength = <20>;
		bias-pull-up;
	};

	twi5_pins_sleep: twi5@1 {
		pins = "PI4", "PI5";
		function = "gpio_in";
	};

	twi6_pins_default: twi6@0 {
		pins = "PE16", "PE17";
		function = "twi6";
		drive-strength = <10>;
		bias-pull-up;
	};

	twi6_pins_sleep: twi6@1 {
		pins = "PE16", "PE17";
		function = "gpio_in";
	};

	ledc_pins_active: ledc@0 {
		pins = "PI6";
		function = "ledc";
	};

	ledc_pins_sleep: ledc@1 {
		pins = "PI6";
		function = "gpio_in";
	};

	spi1_pins_default: spi1@0 {
		pins = "PB12", "PB13", "PB14"; /* clk, mosi, miso */
		function = "spi1";
		drive-strength = <10>;
	};

	spi1_pins_cs: spi1@1 {
		pins = "PB11"; /* cs, hold, wp */
		function = "spi1";
		drive-strength = <10>;
		bias-pull-up;
	};

	spi1_pins_sleep: spi1@2 {
		pins = "PB12", "PB13", "PB14", "PB11";
		function = "io_disabled";
	};

	pwm0_0_pins_active: pwm0@0 {
		pins = "PD0";
		function = "pwm0_0";
	};

	pwm0_0_pins_sleep: pwm0@1 {
		pins = "PD0";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm1_0_pins_active: pwm1@0 {
		pins = "PB6";
		function = "pwm1_0";
	};

	pwm1_0_pins_sleep: pwm1@1 {
		pins = "PB6";
		function = "gpio_in";
		bias-pull-down;
	};

	pwm2_0_pins_active: pwm2@0 {
		pins = "PJ10";
		function = "pwm2_0";
	};

	pwm2_0_pins_sleep: pwm2@1 {
		pins = "PJ10";
		function = "gpio_in";
		bias-pull-down;
	};

	i2s1_pins_a: i2s1@0 {
		pins = "PG11";
		function = "i2s1_bclk";
		drive-strength = <20>;
		bias-disable;
	};

	i2s1_pins_b: i2s1@1 {
		pins = "PG12";
		function = "i2s1_lrck";
		drive-strength = <20>;
		bias-disable;
	};

	i2s1_pins_c: i2s1@2 {
		pins = "PG13";
		function = "i2s1_dout0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s1_pins_d: i2s1@3 {
		pins = "PG14";
		function = "i2s1_din0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s1_pins_e: i2s1@4 {
		pins = "PG11", "PG12", "PG13", "PG14";
		function = "io_disabled";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_a: i2s3@0 {
		pins = "PH10";
		function = "i2s3_bclk";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_b: i2s3@1 {
		pins = "PH11";
		function = "i2s3_lrck";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_c: i2s3@2 {
		pins = "PH13";
		function = "i2s3_din0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_d: i2s3@3 {
		pins = "PH9";
		function = "i2s3_mclk";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_e: i2s3@4 {
		pins = "PH12";
		function = "i2s3_dout0";
		drive-strength = <20>;
		bias-disable;
	};

	i2s3_pins_f: i2s3@5 {
		pins = "PH9", "PH10", "PH11", "PH12", "PH13";
		function = "io_disabled";
		drive-strength = <20>;
		bias-disable;
	};

	ncsi_bt656_pins_a: ncsi_BT656@0 {
		pins = "PK20", "PK22", "PK23",
		"PK4", "PK5", "PK6", "PK7",
		"PK8", "PK9", "PK10", "PK11";
		function = "ncsi";
		drive-strength = <10>;
	};

	ncsi_bt656_pins_b: ncsi_BT656@1 {
		pins = "PK20", "PK22", "PK23",
		"PK4", "PK5", "PK6", "PK7",
		"PK8", "PK9", "PK10", "PK11";
		function = "gpio_in";
	};

	ncsi_bt1120_pins_a: ncsi_BT1120@0 {
		pins = "PK20", "PK22", "PK23",
		"PK4", "PK5", "PK6", "PK7",
		"PK8", "PK9", "PK10", "PK11",
		"PK12", "PK13", "PK14", "PK15",
		"PK16", "PK17", "PK18", "PK19";
		function = "ncsi";
		drive-strength = <10>;
	};

	ncsi_bt1120_pins_b: ncsi_BT1120@1 {
		pins = "PK20", "PK22", "PK23",
		"PK4", "PK5", "PK6", "PK7",
		"PK8", "PK9", "PK10", "PK11",
		"PK12", "PK13", "PK14", "PK15",
		"PK16", "PK17", "PK18", "PK19";
		function = "gpio_in";
	};

	lbc_pins_a: lbc_pins_a@0 {
		pins = "PE0", "PE4", "PE5", "PE6", "PE7",
			"PE8", "PE9", "PE10", "PE11",
			"PE12", "PE13", "PE14", "PE15",
			"PE16", "PE17",
			"PK0", "PK1", "PK2", "PK3",
			"PK4", "PK5", "PK6", "PK7",
			"PK8", "PK9", "PK10", "PK11",
			"PK12", "PK13", "PK14", "PK15",
			"PK16", "PK17", "PK18", "PK19",
			"PK20", "PK21", "PK22", "PK23",
			"PH0", "PH1", "PH2", "PH3",
			"PH4", "PH5", "PH6", "PH7";
		function = "lbus";
		drive-strength = <30>;
		bias-pull-up;
	};

	lbc_pins_b: lbc_pins_b@0 {
		pins = "PE0", "PE4", "PE5", "PE6", "PE7",
			"PE8", "PE9", "PE10", "PE11",
			"PE12", "PE13", "PE14", "PE15",
			"PE16", "PE17",
			"PK0", "PK1", "PK2", "PK3",
			"PK4", "PK5", "PK6", "PK7",
			"PK8", "PK9", "PK10", "PK11",
			"PK12", "PK13", "PK14", "PK15",
			"PK16", "PK17", "PK18", "PK19",
			"PK20", "PK21", "PK22", "PK23",
			"PH0", "PH1", "PH2", "PH3",
			"PH4", "PH5", "PH6", "PH7";
		function = "gpio_in";
	};

	gmac0_pins_default: gmac0@0 {
		pins = "PJ0", "PJ1", "PJ2", "PJ3",
			"PJ4", "PJ5", "PJ6", "PJ7",
			"PJ8", "PJ9", "PJ10", "PJ11",
			"PJ12", "PJ13", "PJ14", "PJ15";
		function = "rgmii0";
		drive-strength = <40>;
		bias-pull-up;
	};

	gmac0_pins_sleep: gmac0@1 {
		pins = "PJ0", "PJ1", "PJ2", "PJ3",
			"PJ4", "PJ5", "PJ6", "PJ7",
			"PJ8", "PJ9", "PJ10", "PJ11",
			"PJ12", "PJ13", "PJ14", "PJ15";
		function = "gpio_in";
	};

	gmac1_pins_default: gmac1@0 {
		pins = "PJ16", "PJ17", "PJ18", "PJ19",
			"PJ20", "PJ21", "PJ22", "PJ23",
			"PJ24", "PJ25", "PJ26", "PJ27",
			"PJ28", "PJ29", "PJ30", "PJ31";
		function = "rgmii1";
		drive-strength = <40>;
		bias-pull-up;
	};

	gmac1_pins_sleep: gmac1@1 {
		pins = "PJ16", "PJ17", "PJ18", "PJ19",
			"PJ20", "PJ21", "PJ22", "PJ23",
			"PJ24", "PJ25", "PJ26", "PJ27",
			"PJ28", "PJ29", "PJ30", "PJ31";
		function = "gpio_in";
	};

	gpadc0_pins_default: gpadc0@0 {
		pins = "PA6", "PA7", "PA8";
		function = "gpadc0";
	};

	gpadc0_pins_sleep: gpadc0@1 {
		pins = "PA6", "PA7", "PA8";
		function = "gpio_in";
	};
};

&r_pio {
	uart15_pins_a: uart15_pins@0 {
		pins = "PL10", "PL11", "PL12", "PL13";
		function = "s_uart0";
		bias-pull-up;
	};

	uart15_pins_b: uart15_pins@1 {
		pins = "PL10", "PL11", "PL12", "PL13";
		function = "io_disabled";
	};

	uart16_pins_a: uart16_pins@0 {
		pins = "PM0", "PM1", "PM2", "PM3";
		function = "s_uart1";
		bias-pull-up;
	};

	uart16_pins_b: uart16_pins@1 {
		pins = "PM0", "PM1", "PM2", "PM3";
		function = "io_disabled";
	};

	s_twi0_pins_default: s_twi0@0 {
		pins = "PL0", "PL1";
		function = "s_twi0";
		drive-strength = <10>;
		bias-pull-up;
	};

	s_twi0_pins_sleep: s_twi0@1 {
		pins = "PL0", "PL1";
		function = "gpio_in";
	};

	s_twi1_pins_default: s_twi1@0 {
		pins = "PL8", "PL9";
		function = "s_twi1";
		drive-strength = <10>;
		bias-pull-up;
	};

	s_twi1_pins_sleep: s_twi1@1 {
		pins = "PL8", "PL9";
		function = "gpio_in";
	};

	s_pwm0_pins_active: s_pwm0@0 {
		pins = "PL10";
		function = "s_pwm0_0";
	};

	s_pwm0_pins_sleep: s_pwm0@1 {
		pins = "PL10";
		function = "gpio_in";
		bias-pull-down;
	};
};

&soc {
	e907_rproc: e907_rproc@1a00000 {
		mboxes = <&msgbox 4>, <&msgbox 6>;
		mbox-names = "arm-kick", "arm-standby";
		memory-region = <&rv_vdev0buffer>, <&rv_vdev0vring0>, <&rv_vdev0vring1>, <&e907_dram_reserved>, <&e907_share_irq_table>;
		fw-region = <&e907_mem_fw>;
		fw-partitions = "riscv0", "riscv0-r";
		fw-partition-sectors = <2048>;
		memory-mappings =
			/* < DA      len        PA >	*/
			/* SRAM A2 */
			< 0x40000    0x2BFFF    0x40000 >,
			/* SHARED SRAM */
			< 0x1000000  0x7ffff    0x1000000 >,
			/* DRAM SPACE1 */
			< 0x40000000 0x3f000000 0x40000000>,
			/* DRAM SPACE2 */
			< 0x80000000 0x3f000000 0x80000000>,
			/* DRAM SPACE3 */
			< 0xC0000000 0x3f000000 0xC0000000>;
		standby-ctrl-en = <0x1>;
		standby-record-reg = <0x07090114>;
		share-irq = "e907";
		status = "okay";
	};

};

