&ve {
	ve-supply = <&reg_dcdc2>;
	status = "okay";
};

&gmac0_phy0 {
	compatible = "ethernet-phy-id001c.c916";
	reset-gpios = <&pio PA 4 GPIO_ACTIVE_LOW>;
	/* For RTL8211F: PHY datasheet rst time */
	reset-assert-us = <10000>;
	reset-deassert-us = <30000>;
};

&gmac0 {
	phy-mode = "rgmii";
	// pinctrl-names = "default", "sleep";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_pins_default>;
	// pinctrl-1 = <&gmac0_pins_sleep>;
	aw,soc-phy25m;
	tx-delay = <15>;
	rx-delay = <3>;
	dwmac3v3-supply = <&reg_dcdc4>;
	phy3v3-supply = <&reg_dcdc4>;
	status = "okay";
};

&gmac1_phy0 {
	compatible = "ethernet-phy-id001c.c916";
	reset-gpios = <&pio PA 3 GPIO_ACTIVE_LOW>;
	/* For RTL8211F: PHY datasheet rst time */
	reset-assert-us = <10000>;
	reset-deassert-us = <30000>;
};

&gmac1 {
	phy-mode = "rgmii";
	// pinctrl-names = "default", "sleep";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1_pins_default>;
	// pinctrl-1 = <&gmac1_pins_sleep>;
	aw,soc-phy25m;
	tx-delay = <15>;
	rx-delay = <3>;
	dwmac3v3-supply = <&reg_dcdc4>;
	phy3v3-supply = <&reg_dcdc4>;
	status = "okay";
};

&rtp {
	allwinner,tp-sensitive-adjust = <0x2>;
	allwinner,filter-type = <0x3>;
	status = "okay";
};

