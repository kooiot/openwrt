&sdc2 {
	non-removable;
	bus-width = <8>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	no-sdio;
	no-sd;
	ctl-spec-caps = <0x328>;
	cap-mmc-highspeed;
	sunxi-power-save-mode;
	sunxi-dis-signal-vol-sw;
	mmc-bootpart-noacc;
	/*cap-hsq;*/
	cqe-on;
	ctl-cmdq-md = <0x2>;
	/* b2c-ecc-on; */
	/* cqe-ecc-on; */
	max-frequency = <150000000>;
	vmmc-supply = <&reg_cldo3>;
	/*emmc io vol 3.3v*/
	/*vqmmc-supply = <&reg_aldo1>;*/
	/*emmc io vol 1.8v*/
	vqmmc-supply = <&reg_cldo1>;
	status = "disabled";
};

&sdc0 {
	bus-width = <4>;
	cd-gpios = <&pio PF 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	/*non-removable;*/
	/*broken-cd;*/
	/*cd-inverted*/
	/*data3-detect;*/
	/*card-pwr-gpios = <&pio PH 14 1 1 2 0xffffffff>;*/
	cd-used-24M;
	cd-set-debounce = <0x1>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	no-sdio;
	no-mmc;
	/* b2c-ecc-on; */
	sunxi-power-save-mode;
	/*sunxi-dis-signal-vol-sw;*/
	max-frequency = <150000000>;
	ctl-spec-caps = <0x428>;
	vmmc-supply = <&reg_cldo3>;
	vqmmc33sw-supply = <&reg_cldo3>;
	vdmmc33sw-supply = <&reg_cldo3>;
	vqmmc18sw-supply = <&reg_aldo4>;
	vdmmc18sw-supply = <&reg_aldo4>;
	status = "okay";
};

&sdc1 {
	bus-width = <4>;
	no-mmc;
	no-sd;
	cap-sd-highspeed;
	/*sd-uhs-sdr12*/
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-ddr50;
	sd-uhs-sdr104;
	/*sunxi-power-save-mode;*/
	sunxi-dis-signal-vol-sw;
	cap-sdio-irq;
	keep-power-in-suspend;
	ignore-pm-notify;
	max-frequency = <208000000>;
	ctl-spec-caps = <0x428>;
	status = "okay";
};

&lradc {
	key_cnt = <4>;
	key0 = <210 172>;
	key1 = <410 158>;
	key2 = <590 115>;
	key3 = <750 114>;
	status = "okay";
};

&gpadc0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&gpadc0_pins_default>;
	pinctrl-1 = <&gpadc0_pins_sleep>;
	channel_num = <2>;
	channel_select = <3>;
	channel_data_select = <0x0>;
	channel_compare_select = <0x0>;
	channel_cld_select = <0x0>;
	channel_chd_select = <0x0>;
	channel0_compare_lowdata = <1700000>;
	channel0_compare_higdata = <1200000>;
	channel1_compare_lowdata = <460000>;
	channel1_compare_higdata = <1200000>;
	gpadc_sample_rate = <1000000>;
	sync = <&gpadc_sync0 0x0>; /* <&sync_group, idx> */
	/* sync_group is used for matching between multiple ports, same within the same group */
	/* idx means the order of starting in sync group, differences within the same group */
	/* gpadc_sample_rate must be the same within the same group */
	status = "okay";
};

&gpadc1 {
	channel_num = <10>; /* the value range is 4 to 10 */
	//only_used_for_gpadc; /* gapdc1 channel0~3 only used for gpadc, can't open is when tpadc used */
	channel_select = <0x3f0>; /* 11 1111 1111: open all channel */
	channel_data_select = <0x0>;
	channel_compare_select = <0x0>;
	channel_cld_select = <0x0>;
	channel_chd_select = <0x0>;
	channel4_compare_lowdata = <1700000>;
	channel4_compare_higdata = <1200000>;
	channel5_compare_lowdata = <460000>;
	channel5_compare_higdata = <1200000>;
	channel6_compare_lowdata = <1700000>;
	channel6_compare_higdata = <1200000>;
	channel7_compare_lowdata = <460000>;
	channel7_compare_higdata = <1200000>;
	channel8_compare_lowdata = <1700000>;
	channel8_compare_higdata = <1200000>;
	channel9_compare_lowdata = <460000>;
	channel9_compare_higdata = <1200000>;
	gpadc_sample_rate = <1000000>;
	sync = <&gpadc_sync0 0x1>; /* <&sync_group, idx> */
	status = "okay";
};

&gpadc2 {
	channel_num = <2>;
	channel_select = <3>;
	channel_data_select = <0>;
	channel_compare_select = <0>;
	channel_cld_select = <0>;
	channel_chd_select = <0>;
	channel0_compare_lowdata = <1700000>;
	channel0_compare_higdata = <1200000>;
	channel1_compare_lowdata = <460000>;
	channel1_compare_higdata = <1200000>;
	gpadc_sample_rate = <1000000>;
	sync = <&gpadc_sync0 0x2>; /* <&sync_group, idx> */
	status = "okay";
};

&gpadc3 {
	channel_num = <1>;
	channel_select = <1>;
	channel_data_select = <0x0>;
	channel_compare_select = <0x0>;
	channel_cld_select = <0x0>;
	channel_chd_select = <0x0>;
	channel0_compare_lowdata = <1700000>;
	channel0_compare_higdata = <1200000>;
	gpadc_sample_rate = <1000000>;
	sync = <&gpadc_sync0 0x3>; /* <&sync_group, idx> */
	status = "okay";
};

&twi0 {
	clock-frequency = <400000>;
	pinctrl-0 = <&twi0_pins_default>;
	pinctrl-1 = <&twi0_pins_sleep>;
	pinctrl-names = "default", "sleep";
	/* For stability and backwards compatibility, we recommend setting ‘twi_drv_used’ to 1 */
	twi_drv_used = <1>;
	twi-supply = <&reg_dcdc4>;
	status = "disabled";
};

