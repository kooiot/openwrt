# PHY Layer Configuration
#

menu "PHY"
	depends on PHYLIB

config AW_MAXIO_PHY
	tristate "MAXIO PHYs"
	help
	Supports the Maxio MAExxxx PHY.

config AW_MOTORCOMM_PHY
	tristate "Motorcomm PHYs"
	help
	  Supports the YT8010, YT8011, YT8510, YT8511, YT8512, YT8522, 
	  YT8521S, YT8531, YT8531S, YT8543, YT8614, YT8614Q, YT8618, 
	  YT8821 PHYs.

endmenu
