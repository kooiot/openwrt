part uuid mmc ${devnum}:2 uuid

setenv loaddtb load mmc ${devnum}:1 ${fdt_addr_r} sunxi.dtb
setenv loadkernel load mmc ${devnum}:1 ${kernel_addr_r} kernel.img
setenv bootargs console=ttyS0,115200 earlycon=uart8250,mmio32,0x0260000 root=PARTUUID=${uuid} rootwait
setenv bootargs earlyprintk=sunxi-uart,0x02600000 initcall_debug=0 console=ttyAS0,115200 loglevel=8 root=PARTUUID=${uuid} rootwait
setenv verify N
setenv uenvcmd run loadkernel \&\& run loaddtb \&\& bootm \$kernel_addr_r - \$fdt_addr_r
run uenvcmd
