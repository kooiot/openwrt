+static int yt8521_led_init(struct phy_device *phydev)
+{
+	struct device_node *of_node = phydev->mdio.dev.of_node;
+	int ret;
+	u32 i, val;
+	char buf[64];
+
+	for (i = 0; i < YT8521_LED_COUNT; ++i) {
+		/* get led configuration */
+		snprintf(buf, 64, "motorcomm,led%d", i);
+		if (!of_property_read_u32(of_node, buf, &val) ) {
+#ifdef YT8521_DEBUG
+			phydev_info(phydev, "led%d config val: %08x node:%pOF", i, val, of_node);
+#endif
+			ret = ytphy_write_ext(phydev, YT8521_LED0_CONFIG_REG + i, val);
+			if (ret < 0) {
+				break;
+			}
+		}
+	}
+
+	return ret;
+}
