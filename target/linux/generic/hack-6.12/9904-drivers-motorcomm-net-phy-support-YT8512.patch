+static int yt8512_clk_init(struct phy_device *phydev)
+{
+	struct device_node *node = phydev->mdio.dev.of_node;
+	const char *strings = NULL;
+	int ret;
+	int val;
+	int max_cnt = 500; /* the max wait time of reset ~ 500 ms */
+
+	if (node && node->parent && node->parent->parent) {
+		ret = of_property_read_string(node->parent->parent,
+					      "clock_in_out", &strings);
+		if (!ret) {
+			if (!strcmp(strings, "input"))
+				return 0;
+		}
+	}
+
+	val = ytphy_read_ext(phydev, YT8512_EXTREG_AFE_PLL);
+	if (val < 0)
+		return val;
+
+	val |= YT8512_CONFIG_PLL_REFCLK_SEL_EN;
+
+	ret = ytphy_write_ext(phydev, YT8512_EXTREG_AFE_PLL, val);
+	if (ret < 0)
+		return ret;
+
+	val = ytphy_read_ext(phydev, YT8512_EXTREG_EXTEND_COMBO);
+	if (val < 0)
+		return val;
+
+	val |= YT8512_CONTROL1_RMII_EN;
+
+	ret = ytphy_write_ext(phydev, YT8512_EXTREG_EXTEND_COMBO, val);
+	if (ret < 0)
+		return ret;
+
+	ret = __phy_modify(phydev, MII_BMCR, BMCR_RESET, BMCR_RESET);
+	if (ret < 0)
+		return ret;
+
+	/* Need to wait for the reset to complete */
+	while (max_cnt--) {
+		usleep_range(1000, 1100);
+		ret = __phy_read(phydev, MII_BMCR);
+		if (ret < 0)
+			return ret;
+
+		if (!(ret & BMCR_RESET))
+			break;
+	}
+
+	return ret;
+}
+
+static int yt8512_led_init(struct phy_device *phydev)
+{
+	struct device_node *of_node = phydev->mdio.dev.of_node;
+	int ret;
+	int val;
+	int mask;
+
+	val = ytphy_read_ext(phydev, YT8512_EXTREG_LED0);
+	if (val < 0)
+		return val;
+#ifdef YT8512_DEBUG
+	phydev_info(phydev, "read led0 config val: %x", val);
+#endif
+
+	if (of_property_read_u32(of_node, "motorcomm,led0", &val)) {
+#ifdef YT8512_DEBUG
+		phydev_info(phydev, "no led0 config val");
+#endif
+		val |= YT8512_LED0_ACT_BLK_IND;
+
+		mask = YT8512_LED0_DIS_LED_AN_TRY | YT8512_LED0_BT_BLK_EN |
+			YT8512_LED0_HT_BLK_EN | YT8512_LED0_COL_BLK_EN |
+			YT8512_LED0_BT_ON_EN;
+		val &= ~mask;
+#ifdef YT8512_DEBUG
+	} else {
+		phydev_info(phydev, "led0 config val: %x of_node:%pOF", val, of_node);
+#endif
+	}
+
+	ret = ytphy_write_ext(phydev, YT8512_EXTREG_LED0, val);
+	if (ret < 0)
+		return ret;
+#ifdef YT8512_DEBUG
+	val = ytphy_read_ext_with_lock(phydev, YT8512_EXTREG_LED0);
+	phydev_info(phydev, "read led0 after write config val: %x", val);
+#endif
+
+	val = ytphy_read_ext(phydev, YT8512_EXTREG_LED1);
+	if (val < 0)
+		return val;
+#ifdef YT8512_DEBUG
+	phydev_info(phydev, "read led1 config val: %x", val);
+#endif
+
+	if (of_property_read_u32(of_node, "motorcomm,led1", &val)) {
+#ifdef YT8512_DEBUG
+		phydev_info(phydev, "no led1 config val");
+#endif
+		val |= YT8512_LED1_BT_ON_EN;
+
+		mask = YT8512_LED1_TXACT_BLK_EN | YT8512_LED1_RXACT_BLK_EN;
+		val &= ~mask;
+#ifdef YT8512_DEBUG
+	} else {
+		phydev_info(phydev, "led1 config val: %x of_node:%pOF", val, of_node);
+#endif
+	}
+
+	ret = ytphy_write_ext(phydev, YT8512_EXTREG_LED1, val);
+
+#ifdef YT8512_DEBUG
+	val = ytphy_read_ext_with_lock(phydev, YT8512_EXTREG_LED1);
+	phydev_info(phydev, "read led1 after write config val: %x", val);
+#endif
+	return ret;
+}
+
+static int yt8512_config_init(struct phy_device *phydev)
+{
+	int ret;
+	int val;
+
+	ret = yt8512_clk_init(phydev);
+	if (ret < 0)
+		return ret;
+
+	ret = yt8512_led_init(phydev);
+	if (ret < 0)
+		return ret;
+
+	/* disable auto sleep */
+	val = ytphy_read_ext_with_lock(phydev, YT8512_EXTREG_SLEEP_CONTROL1);
+	if (val < 0)
+		return val;
+
+	val &= (~BIT(YT8512_EN_SLEEP_SW_BIT));
+
+	ret = ytphy_write_ext_with_lock(phydev, YT8512_EXTREG_SLEEP_CONTROL1, val);
+	if (ret < 0)
+		return ret;
+
+	return ret;
+}
+
+static int yt8512_read_status(struct phy_device *phydev)
+{
+	int ret;
+	int val;
+	int speed, speed_mode, duplex;
+
+	ret = genphy_update_link(phydev);
+	if (ret)
+		return ret;
+
+	val = phy_read(phydev, YTPHY_SPECIFIC_STATUS_REG);
+	if (val < 0)
+		return val;
+
+	duplex = (val & YT8512_DUPLEX) >> YT8512_DUPLEX_BIT;
+	speed_mode = (val & YT8512_SPEED_MODE) >> YT8512_SPEED_MODE_BIT;
+	switch (speed_mode) {
+	case 0:
+		speed = SPEED_10;
+		break;
+	case 1:
+		speed = SPEED_100;
+		break;
+	case 2:
+	case 3:
+	default:
+		speed = SPEED_UNKNOWN;
+		break;
+	}
+
+	phydev->speed = speed;
+	phydev->duplex = duplex;
+
+	return 0;
+}
