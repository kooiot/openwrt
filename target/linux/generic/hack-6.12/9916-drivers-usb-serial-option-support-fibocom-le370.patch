--- a/drivers/net/usb/cdc_ether.c
+++ b/drivers/net/usb/cdc_ether.c
@@ -473,6 +473,20 @@ static int usbnet_cdc_zte_bind(struct us
 	return status;
 }
 
+static int usbnet_cdc_fibocom_bind(struct usbnet *dev, struct usb_interface *intf)
+{
+	u8 addr[ETH_ALEN];
+	int status = usbnet_cdc_bind(dev, intf);
+
+	if (!status && (dev->net->dev_addr[0] & 0x20)) {
+		ether_addr_copy(addr, dev->net->dev_addr);
+		addr[0] = 0x02; // Set to loacal addr
+		eth_hw_addr_set(dev->net, addr);
+	}
+
+	return status;
+}
+
