. /lib/functions.sh
. /lib/functions/tlink.sh

tlink_disable_lan_dhcp() {
	uci del dhcp.lan && uci commit dhcp
}

tlink_mount_data() {
	data_blk_p="/dev/mmcblk1p3"
	if [ ! -b $data_blk_p ]; then
		if [ -b "/dev/mmcblk2p3" ]; then
			data_blk_p="/dev/mmcblk2p3"
		fi
	fi
	# 检查data分区是否存在
	if [ ! -b $data_blk_p ]; then
		echo "ERROR: eMMC data partition not found!!!" > /dev/kmsg
		return 1
	fi

	if [ -b "/dev/mmcblk1p4"]; then
		echo "eMMC not initialized!!!" > /dev/kmsg
		return 1
	fi
	if [ -b "/dev/mmcblk1p5"]; then
		echo "eMMC not initialized!!!" > /dev/kmsg
		return 1
	fi

	rule_name=$(uci add fstab mount)
	uci batch <<EOF
set fstab.$rule_name.target='/mnt/data'
set fstab.$rule_name.device='$data_blk_p'
set fstab.$rule_name.fstype='ext4'
set fstab.$rule_name.options='rw,async'
set fstab.$rule_name.enabled='1'
set fstab.$rule_name.enabled_fsck='1'
EOF
	uci commit fstab
	return 0
}

# 查找名为 backup 的 UBI 卷并返回其设备节点
find_backup_dev() {
    for vol in /sys/class/ubi/ubi0_*; do
        if [ -f "$vol/name" ] && [ "$(cat "$vol/name")" = "backup" ]; then
            echo "/dev/$(basename "$vol")"
            return 0
        fi
    done
    return 1
}

tlink_mount_tfcard() {
	rule_name=$(uci add fstab mount)
	uci batch <<EOF
set fstab.$rule_name.target='/mnt/sdcard'
set fstab.$rule_name.device='/dev/mmcblk0p1'
set fstab.$rule_name.enabled='1'
set fstab.$rule_name.check_fs='1'
EOF
	uci commit fstab

	return 0
}

tlink_mount_ubi_backup() {
	# 检查ubi0分区是否存在
	if [ ! -e /dev/ubi0 ]; then
		echo "UBI0 not found!!!" > /dev/kmsg
		return 1
	fi

	ubi_part_device=$(find_backup_dev)

	if [ -z "$ubi_part_device" ]; then
		echo "ERROR: UBI has no backup partition!!!" > /dev/kmsg
		return 1
	fi

	rule_name=$(uci add fstab mount)
	uci batch <<EOF
set fstab.$rule_name.target='/mnt/backup'
set fstab.$rule_name.device='$ubi_part_device'
set fstab.$rule_name.enabled='1'
EOF
	uci commit fstab

	return 0
}

tlink_add_wwan_interface() {
	uci set network.wwan='interface'
	uci set network.wwan.proto='wwan'
	uci set network.wwan.pdptype='IP'
	uci commit network
}

# WAN is eth1 which is usb-eth has not unique MAC
tlink_set_wan_mac() {
	local MACADDR

	export_tlink_efuse_mac MACADDR 2 || {
		return
	}

	uci set network.wan.macaddr=${MACADDR}
	uci set network.wan6.macaddr=${MACADDR}
	uci commit network

	return
}

tlink_check_boot() {
	mkdir -p /tmp/boot_p1
	mount /dev/mmcblk0p1 /tmp/boot_p1
	if [ -f /tmp/boot_p1/u-boot-sunxi-with-spl.bin ]; then
		umount /tmp/boot_p1
		return 0
	fi
	umount /tmp/boot_p1
	return 1
}

tlink_auto_start_install() {
	echo "sleep 3" > /sbin/boot_sd_install
	echo "install_to_emmc -f" >> /sbin/boot_sd_install
	echo "if [ \$? -ne 0 ]; then" >> /sbin/boot_sd_install
	echo "    echo \"Failed to install firmware to eMMC\"" >> /sbin/boot_sd_install
	echo "else" >> /sbin/boot_sd_install
	echo "    echo \"Install firmware to eMMC is done!!\"" >> /sbin/boot_sd_install
	echo "    echo \"System halt now!!\"" >> /sbin/boot_sd_install
	echo "    sync" >> /sbin/boot_sd_install
	echo "    halt" >> /sbin/boot_sd_install
	echo "fi" >> /sbin/boot_sd_install
	chmod a+x /sbin/boot_sd_install

	echo "boot_sd_install > /dev/console 2>&1  &" > /etc/rc.local
	echo "exit 0" >> /etc/rc.local

	sync
	
	echo "This is an BOOT SD!!!!" > /dev/kmsg
	echo "You need to restart device mannually!!" > /dev/kmsg
}

tlink_sd_default () {
	local partdev

	. /lib/upgrade/common.sh

	if export_bootdevice && export_partdevice partdev 0; then
		if [ "$partdev" = "mmcblk0" ]; then
			if tlink_check_boot; then
				tlink_auto_start_install
				return
			fi
		fi
	fi
}


tlink_default() {
	# tlink_sd_default

	# disable dhcp on lan
	tlink_disable_lan_dhcp

	# data partition mount
	if ( grep -qs '/mnt/data' /etc/config/fstab || \
		tlink_mount_data )
	then
		echo "Data parition mount point added!!!" > /dev/kmsg
	fi
	# backup partition mount
	if ( grep -qs '/mnt/backup' /etc/config/fstab || \
		tlink_mount_ubi_backup )
	then
		echo "UBI Backup parition mount point added!!!" > /dev/kmsg
	fi
	# add tf-card partition mount
	if ( grep -qs '/mnt/tfcard' /etc/config/fstab || \
		tlink_mount_tfcard )
	then
		echo "TF-Card mount point added!!!" > /dev/kmsg
	fi

	tlink_add_wwan_interface

	# set ttylogin (for ttyS0, default will promote console with password)
	# set system.@system[0].ttylogin='1'
	# uci commit system
}

case "$(board_name)" in
"kooiot,tlink-rk3506g-iot"|\
"vanxoak,vx-hd-rk3506g-iot"|\
"vanxoak,vx-hd-rk3506g-m-iot")
	tlink_default
	;;
"vanxoak,vx-hd-rk3506g-iot-spinand"|\
"vanxoak,vx-hd-rk3506g-m-iot-spinand")
	tlink_default
	# Do export product sn here, as fw_env.config is ready now.
	tlink_do_export_product_sn_from_ubootenv
	;;
esac
