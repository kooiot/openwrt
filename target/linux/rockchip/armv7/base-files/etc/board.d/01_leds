#!/bin/sh

. /lib/functions/leds.sh
. /lib/functions/uci-defaults.sh

board=$(board_name)
boardname="${board##*,}"

board_config_update

case $board in
hzhy,rk3506sp-mini-evm|\
hzhy,rk3506sp-mini-evm-emmc|\
hzhy,rk3506sp-mini-evm-nand)
	ucidef_set_led_netdev "wan" "WAN" "green:wan" "eth0"
	;;
vanxoak,vx-hd-rk3506g-iot|\
vanxoak,vx-hd-rk3506g-iot-spinand)
	ucidef_set_led_netdev "modem" "modem" "kooiot:green:modem" "wwan0"
	;;
esac

board_config_flush

exit 0
