do_kooiot_tlink_spinnand() {
	. /lib/functions.sh
	. /lib/functions/tlink.sh

	case "$(board_name)" in
	"kooiot,tlink-dly-m304-spinand" |\
	"vanxoak,vx-hd-rk3506g-iot-spinand" |\
	"vanxoak,vx-hd-rk3506g-m-iot-spinand" )
		do_export_product_sn_from_ubootenv
		;;
	esac
}

boot_hook_add preinit_main do_kooiot_tlink_spinnand
