/dts-v1/;

#include <dt-bindings/input/input.h>
#include "rk3506.dtsi"

/ {
	model = "HD-RK3506G-IOT";
	compatible = "vanxoak,vx-hd-rk3506g-iot", "rockchip,rk3506";
	chosen: chosen {
		stdout-path = "serial0:115200n8";
	};

	/* PSCI is provided by the Rockchip OP-TEE secure monitor.
	 * Linux brings up secondary CPUs via PSCI SMC calls. */

	aliases {
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		i2c0 = &i2c0;
		i2c2 = &i2c2;
		spi0 = &sfc;
	};

	chosen {
		stdout-path = &uart0;
	};

	pwm0_4ch_0: pwm@ff930000 {
		compatible = "rockchip,rk3506-pwm", "rockchip,rk3576-pwm";
		reg = <0xff930000 0x200>;
		interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&cru CLK_PWM0>, <&cru PCLK_PWM0>, <&cru CLK_OSC_PWM0>;
		clock-names = "pwm", "pclk", "osc";
		#pwm-cells = <3>;
		status = "disabled";
	};

	vcc12v_dc: vcc12v-dc {
		compatible = "regulator-fixed";
		regulator-name = "vcc12v_dc";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc_sys: vcc-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc12v_dc>;
	};

	vcc3v3_stb: vcc3v3-stb {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_stb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc_sys>;
	};

	vcc_1v8: vcc-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "vcc_1v8";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		vin-supply = <&vcc3v3_stb>;
	};

	vdd_arm: vdd-arm {
		compatible = "pwm-regulator";
		pwms = <&pwm0_4ch_0 0 5000 1>;
		regulator-name = "vdd_arm";
		regulator-min-microvolt = <710000>;
		regulator-max-microvolt = <1207000>;
		regulator-init-microvolt = <1011000>;
		regulator-always-on;
		regulator-boot-on;
		regulator-settling-time-up-us = <250>;
		vin-supply = <&vcc_sys>;
	};

	ext_gmac0: external-gmac-clock-0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
		clock-output-names = "ext_gmac_0";
	};

	ext_gmac1: external-gmac-clock-1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <50000000>;
		clock-output-names = "ext_gmac_1";
	};

	leds: leds {
		compatible = "gpio-leds";
		status = "okay";

		status_led: status-led {
			label = "kooiot:green:status";
			gpios = <&gpio1 RK_PB3 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "heartbeat";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&key_reset_pin>;

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&gpio4 RK_PB1 GPIO_ACTIVE_LOW>;
		};
	};
	
	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		hub_reset {
			gpio-export,name = "hub_reset";
			gpio-export,output=<1>;
			gpios = <&gpio0 RK_PB1 GPIO_ACTIVE_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&hub_reset_pin>;
		};
	};
};

&tsadc {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "disabled";
};

&uart2 {
	status = "disabled";
};

&uart3 {
	status = "disabled";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io25_i2c0_scl &rm_io24_i2c0_sda>;

	rtc_RS4C1339: rtc@68 {
		compatible = "dallas,ds1339";
		reg = <0x68>;
		status = "okay";
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_i2c2_scl &rm_io5_i2c2_sda>;

	rjgt102: crypt@68 {
		compatible = "rjgt102";
		reg = <0x68>;
		status = "okay";
	};
};

&rng {
	status = "okay";
};

&sai1 {
	status = "disabled";
};

&usb2phy {
	status = "okay";
};

&u2phy_otg0 {
	status = "okay";
};

&u2phy_otg1 {
	status = "okay";
};

&usb20_otg0 {
	dr_mode = "peripheral";
	status = "okay";
};

&usb20_otg1 {
	dr_mode = "host";
	status = "okay";
};

&gmac0 {
	phy-mode = "rmii";
	clock_in_out = "input";

	snps,reset-gpio = <&gpio0 RK_PB3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	// assigned-clocks = <&cru CLK_MAC0_PTP>;
	// assigned-clock-parents = <&ext_gmac0>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii0_miim_pins
				 &eth_rmii0_tx_bus2_pins
				 &eth_rmii0_rx_bus2_pins
				 &eth_rmii0_clk_pins>;

	phy-handle = <&rmii_phy0>;

	status = "okay";
};

&mdio0 {
	rmii_phy0: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		motorcomm,led0 = <0x30>;
		motorcomm,led1 = <0x331>;
		reg = <0x0>;
	};
};

&gmac1 {
	phy-mode = "rmii";
	clock_in_out = "input";

	snps,reset-gpio = <&gpio0 RK_PB4 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;

	// assigned-clocks = <&cru CLK_MAC1_PTP>;
	// assigned-clock-parents = <&ext_gmac1>;

	pinctrl-names = "default";
	pinctrl-0 = <&eth_rmii1_miim_pins
				 &eth_rmii1_tx_bus2_pins
				 &eth_rmii1_rx_bus2_pins
				 &eth_rmii1_clk_pins>;

	phy-handle = <&rmii_phy1>;
	status = "okay";
};

&mdio1 {
	rmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		motorcomm,led0 = <0x30>;
		motorcomm,led1 = <0x331>;
		reg = <0x0>;
	};
};

&pwm0_4ch_0 {
	pinctrl-names = "active";
	pinctrl-0 = <&rm_io29_pwm0_ch2>;
	status = "okay";
};

&sfc {
	status = "okay";
	flash: spinand@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <80000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
	};
};

&mmc {
	bus-width = <4>;
	cs-gpios = <&gpio0 RK_PB0 GPIO_ACTIVE_LOW>;
	cap-sd-highspeed;
	disable-wp;
	no-sdio;
	no-mmc;
	no-1-8-v;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc_clk_pins &sdmmc_cmd_pins &sdmmc_bus4_pins &sdmmc_det_pins>;
	vmmc-supply = <&vcc3v3_stb>;
	vqmmc-supply = <&vcc3v3_stb>;
	status = "okay";
};

&pinctrl {
	headphone {
		hp_det: hp-det {
			rockchip,pins = <1 RK_PA6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	keys {
		key_reset_pin: key-reset-pin {
			rockchip,pins = <4 RK_PB1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	usb {
		vcc5v0_otg0_en: vcc5v0-otg0-en {
			rockchip,pins = <1 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		vcc5v0_otg1_en: vcc5v0-otg1-en {
			rockchip,pins = <1 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
		hub_reset_pin: hub-reset-pin {
			rockchip,pins = <0 RK_PB1 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
	i2c0 {
		/omit-if-no-ref/
		rm_io25_i2c0_scl: rm-io25-i2c0-scl {
			rockchip,pins =
				<1 RK_PB2 30 &pcfg_pull_none>;
		};

		/omit-if-no-ref/
		rm_io24_i2c0_sda: rm-io24-i2c0-sda {
			rockchip,pins =
				<1 RK_PB1 31 &pcfg_pull_none>;
		};
	};
	pwm {
		/omit-if-no-ref/
		rm_io29_pwm0_ch2: rm-io29-pwm0-ch2 {
			rockchip,pins =
				<1 RK_PD1 47 &pcfg_pull_none_drv_level_1>;
		};
	};
	sdmmc_det {
		/omit-if-no-ref/
		sdmmc_det_pins: sdmmc-det-pins {
			rockchip,pins =
				/* sdmmc_det */
				<0 RK_PB0 1 &pcfg_pull_up_drv_level_3>;
		};
	};

	/omit-if-no-ref/
	pcfg_pull_up_drv_level_3: pcfg-pull-up-drv-level-3 {
		bias-pull-up;
		drive-strength = <3>;
	};

	/omit-if-no-ref/
	pcfg_pull_none_drv_level_1: pcfg-pull-none-drv-level-1 {
		bias-disable;
		drive-strength = <1>;
	};
};

