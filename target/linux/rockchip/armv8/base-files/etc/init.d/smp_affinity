#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=bash
# shellcheck disable=2155,3019,3043,3057,3060
######################################################################

START=93
PROG=smp_affinity

log_msg() {
	local type="$1" id="$2" name="$3" affinity="$4"

	logger -t "$PROG" "Pinning $type($id) $name to CPU $affinity"
}

get_irq() {
	awk -v name="$1" '$NF == name {
		sub(/:$/, "", $1)
		print $1
		exit
	}' /proc/interrupts
}

pin_irq() {
	local irq="$1" mask="$2" affinity="$3" name="$4"

	[ -n "$irq" ] || return
	$enable_log && log_msg IRQ "$irq" "$name" "$affinity"
	echo "$mask" > "/proc/irq/$irq/smp_affinity"
}

######################################################################
### Takes a comma, space separated, or range list of CPU numbers and
## returns a bitmask of CPUs.
## cpus_to_bitmask "0,1,2,3" -> f
## cpus_to_bitmask "0 1 2 3" -> f
## cpus_to_bitmask "0-3"     -> f
## cpus_to_bitmask "3"       -> 8
#######################################################################

cpus_to_bitmask() {
	local bitmask=0
	# shellcheck disable=2048
	for range in ${*//,/ }; do
		start="${range%-*}"
	end="${range#*-}"
	if [ -z "$end" ]; then
		bitmask="$((bitmask | 1 << start))"
	else
		bitmask="$((bitmask | (2 ** (end - start + 1) - 1) << start))"
	fi
done
printf '%x' $bitmask
}

######################################################################
### Takes a bitmask of CPUs and returns a space separated list of
## CPU numbers.
## bitmask_to_cpus f -> 0 1 2 3
######################################################################

bitmask_to_cpus() {
	[ "${1:0:2}" != "0x" ] && set -- "0x$1"
	local bitmask="$(printf '%d' "$1")"

	local cpus=""
	for i in $(seq 0 63); do
		if [ $((bitmask & 1)) -ne 0 ]; then
			cpus="$cpus $i"
		fi
		bitmask=$((bitmask >> 1))
	done
	echo "${cpus# }"
}

######################################################################
### Sets the affinity of the IRQs with the given name to the given CPU.
## 1st argument: IRQ name ("lan0") (req)
## 2nd argument: CPU number (req)
######################################################################

set_affinity() {
	local seconds=0 irq_name="$1" affinity="$2" bitmask irq

	while [ "$seconds" -lt 60 ]; do
		irq="$(get_irq $irq_name)"
		[ -n "$irq" ] && break

		seconds=$((seconds + 1))
		sleep 1
	done

	[ -n "$irq" ] || {
		$enable_log && logger -t "$PROG" "IRQ: ${irq_name} does not exits"
		return
	}

	bitmask=$(cpus_to_bitmask "$affinity") && pin_irq "$irq" "$bitmask" "$affinity" "$irq_name"
}

set_network_smp_affinity() {
	local cfg="$1"
	local interface device cpu enabled
	config_get_bool enabled "$cfg" enabled 1
	config_get interface "$cfg" interface 
	config_get device "$cfg" device 
	config_get cpu "$cfg" cpu 

	[ "$enabled" -eq 1 ] || return 0
	[ -z "$cpu" ] && return 0

	[ -z "${device}" ] && device="$interface"
	[ -z "$device" ] && return 0

	[ -e "/sys/class/net/${interface}" ] || {
		$enable_log && logger -t "$PROG" "${interface} does not exits"
		return 0
	}

	set_affinity "$device" "$cpu"

	return 0
}

boot() {
	local enable

	config_load     smp_affinity

	config_get_bool enable     "general" enable     1
	config_get_bool enable_log "general" enable_log 1

	[ "$enable"     -eq 1 ] && enable=true     || enable=false
	[ "$enable_log" -eq 1 ] && enable_log=true || enable_log=false

	$enable && {
		$enable_log && logger -t "$PROG" "Start to process smp affinity...."
		config_foreach set_network_smp_affinity network 
	}
}
