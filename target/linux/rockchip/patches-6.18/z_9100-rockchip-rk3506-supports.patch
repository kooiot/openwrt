+
+		dev_dbg(sfc->dev, "tuning read data %02x %02x %02x\n", buf[0], buf[1], buf[2]);
+		if (memcmp(buf, SNOR_IDB_TAG_NS, SFC_TUNING_ITEM_SIZE) &&
+		    memcmp(buf, SNOR_IDB_TAG_SS, SFC_TUNING_ITEM_SIZE))
