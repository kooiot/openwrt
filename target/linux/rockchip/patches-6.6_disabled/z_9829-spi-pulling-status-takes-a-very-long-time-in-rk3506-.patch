From f8522f80f056510b0503217522197660ab2f2d29 Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Fri, 11 Sep 2026 20:30:11 +0800
Subject: [PATCH 9829/9829] spi: pulling status takes a very long time in
 rk3506 with xtx spinand

refer to https://lore-kernel.gnuweeb.org/lkml/20260519102446.209723-1-peter@pcc.me.uk/
---
 drivers/spi/spi-mem.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/drivers/spi/spi-mem.c b/drivers/spi/spi-mem.c
index 932992b06022..a12a17dc564e 100644
--- a/drivers/spi/spi-mem.c
+++ b/drivers/spi/spi-mem.c
@@ -887,7 +887,13 @@ int spi_mem_poll_status(struct spi_mem *mem,
 			usleep_range((initial_delay_us >> 2) + 1,
 				     initial_delay_us);
 
-		ret = read_poll_timeout(spi_mem_read_status, read_status_ret,
+		// 400 * 10 = 4 * 1000, firstly wait for about 4 ms at most
+		ret = read_poll_timeout_atomic(spi_mem_read_status, read_status_ret,
+					(read_status_ret || ((status) & mask) == match),
+					polling_delay_us, timeout_ms * 10, false, mem,
+					op, &status);
+		if (ret)
+			ret = read_poll_timeout(spi_mem_read_status, read_status_ret,
 					(read_status_ret || ((status) & mask) == match),
 					polling_delay_us, timeout_ms * 1000, false, mem,
 					op, &status);
