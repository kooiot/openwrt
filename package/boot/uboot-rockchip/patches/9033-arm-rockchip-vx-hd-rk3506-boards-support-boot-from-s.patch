 CONFIG_ROCKCHIP_SFC=y
@@ -77,10 +77,5 @@ CONFIG_USB_GADGET_DWC2_OTG=y
 CONFIG_USB_GADGET_VBUS_DRAW=500
 CONFIG_USB_GADGET_DOWNLOAD=y
