+CONFIG_ROCKCHIP_SDRAM_COMMON=y
--- a/configs/vx-hd-rk3506g-iot_defconfig
+++ b/configs/vx-hd-rk3506g-iot_defconfig
@@ -13,12 +13,10 @@ CONFIG_SPL_LIBDISK_SUPPORT=y
 CONFIG_SYS_LOAD_ADDR=0x200000
 CONFIG_DEBUG_UART=y
