From 41b630439493e7d2a9ca3507f159552d5df2b5f3 Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Sat, 5 Sep 2026 23:34:14 +0800
Subject: [PATCH] arm: rockchip: vx-hd-rk3506g boards support boot from spi nand

---
 ...k3506-vx-hd-rk3506g-iot-spinand-u-boot.dtsi |  6 ++++++
 .../dts/rk3506-vx-hd-rk3506g-iot-u-boot.dtsi   |  6 ++++++
 arch/arm/dts/rockchip-u-boot.dtsi             |  5 +++++
 arch/arm/mach-rockchip/spl.c                  | 15 +++++++++++++
 common/spl/spl_fit.c                          |  4 ++--
 configs/vx-hd-rk3506g-iot-spinand_defconfig    | 21 ++++++++++---------
 configs/vx-hd-rk3506g-iot_defconfig            | 11 +++-------
 lib/hang.c                                    |  7 +++++++
 8 files changed, 55 insertions(+), 20 deletions(-)

--- a/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand-u-boot.dtsi
+++ b/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand-u-boot.dtsi
@@ -2,6 +2,12 @@
 
 #include "rk3506-u-boot.dtsi"
 
+/ {
+	chosen {
+		u-boot,spl-boot-order = "same-as-spl", &sdmmc, &flash;
+	};
+};
+
 &flash {
 	bootph-pre-ram;
 	bootph-some-ram;
--- a/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-u-boot.dtsi
+++ b/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-u-boot.dtsi
@@ -2,6 +2,12 @@
 
 #include "rk3506-u-boot.dtsi"
 
+/ {
+       chosen {
+               u-boot,spl-boot-order = "same-as-spl", &sdmmc, &flash;
+       };
+};
+
 &flash {
 	bootph-pre-ram;
 	bootph-some-ram;
--- a/arch/arm/dts/rockchip-u-boot.dtsi
+++ b/arch/arm/dts/rockchip-u-boot.dtsi
@@ -121,8 +121,13 @@
 				arch = FIT_ARCH;
 				os = "tee";
 				compression = "none";
+#ifdef CONFIG_ROCKCHIP_RK3506
+				load = <(CFG_SYS_SDRAM_BASE + 0x1000)>;
+				entry = <(CFG_SYS_SDRAM_BASE + 0x1000)>;
+#else
 				load = <(CFG_SYS_SDRAM_BASE + 0x8400000)>;
 				entry = <(CFG_SYS_SDRAM_BASE + 0x8400000)>;
+#endif
 
 				tee-os {
 				};
--- a/arch/arm/mach-rockchip/spl.c
+++ b/arch/arm/mach-rockchip/spl.c
@@ -95,6 +95,21 @@ __weak int arch_cpu_init(void)
 	return 0;
 }
 
+#ifdef CONFIG_SPL_BUILD
+void spl_hang_reset(void)
+{
+#if defined(CONFIG_SPL_SYSRESET) && defined(CONFIG_SPL_DRIVERS_MISC_SUPPORT)
+	/* reset is available after dm setup */
+	if (gd->flags & GD_FLG_SPL_EARLY_INIT) {
+		printf("# Reset the board to bootrom #\n");
+		writel(BOOT_BROM_DOWNLOAD, CONFIG_ROCKCHIP_BOOT_MODE_REG);
+		do_reset(NULL, 0, 0, NULL);
+	}
+#endif
+}
+#endif
+
+
 void board_init_f(ulong dummy)
 {
 	int ret;
--- a/common/spl/spl_fit.c
+++ b/common/spl/spl_fit.c
@@ -323,8 +323,8 @@ static int load_simple_fit(struct spl_lo
 	}
 
 	if (CONFIG_IS_ENABLED(FIT_SIGNATURE)) {
-		printf("## Checking hash(es) for Image %s ... ",
-		       fit_get_name(fit, node, NULL));
+		printf("## Checking hash(es) for Image %s 0x%08x ... ",
+		       fit_get_name(fit, node, NULL), (int)src);
 		if (!fit_image_verify_with_data(fit, node, gd_fdt_blob(), src,
 						length))
 			return -EPERM;
--- a/configs/vx-hd-rk3506g-iot-spinand_defconfig
+++ b/configs/vx-hd-rk3506g-iot-spinand_defconfig
@@ -2,7 +2,7 @@ CONFIG_ARM=y
 CONFIG_SKIP_LOWLEVEL_INIT=y
