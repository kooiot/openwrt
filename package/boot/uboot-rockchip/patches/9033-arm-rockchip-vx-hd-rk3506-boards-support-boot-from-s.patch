 CONFIG_SPI_FLASH_GIGADEVICE=y
@@ -70,8 +78,6 @@ CONFIG_DM_MDIO=y
 CONFIG_DWC_ETH_QOS=y
 CONFIG_DWC_ETH_QOS_ROCKCHIP=y
 CONFIG_PHY_ROCKCHIP_INNO_USB2=y
-CONFIG_ROCKCHIP_SDRAM_COMMON=y
-CONFIG_BAUDRATE=115200
