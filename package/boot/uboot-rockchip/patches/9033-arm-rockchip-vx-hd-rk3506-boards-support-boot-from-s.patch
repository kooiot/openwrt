 CONFIG_SYS_NS16550_MEM32=y
 CONFIG_ROCKCHIP_SFC=y
@@ -83,10 +89,6 @@ CONFIG_USB_GADGET_DWC2_OTG=y
 CONFIG_USB_GADGET_VBUS_DRAW=500
