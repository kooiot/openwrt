 CONFIG_ERRNO_STR=y
 CONFIG_OPTEE_IMAGE=y
 CONFIG_ROCKCHIP_SDRAM_COMMON=y
+CONFIG_LZ4=y
+CONFIG_LZMA=y
diff --git a/configs/vx-hd-rk3506-iot_defconfig b/configs/vx-hd-rk3506-iot_defconfig
index c4809ba237d..61c394538ed 100644
--- a/configs/vx-hd-rk3506-iot_defconfig
+++ b/configs/vx-hd-rk3506-iot_defconfig
@@ -79,3 +79,5 @@ CONFIG_USB_GADGET_DOWNLOAD=y
 CONFIG_USB_FUNCTION_ROCKUSB=y
 CONFIG_ERRNO_STR=y
 CONFIG_OPTEE_IMAGE=y
+CONFIG_LZ4=y
+CONFIG_LZMA=y
