From 2cb48bc1d6f6b757ec460c3eda8f3cc11828e62c Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Thu, 3 Sep 2026 16:52:19 +0800
Subject: [PATCH 9026/9034] arm: dts: rockchip rk3506 sfc spi improve

---
 arch/arm/dts/rk3506.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/arch/arm/dts/rk3506.dtsi b/arch/arm/dts/rk3506.dtsi
index 01810042ff5..dc3dd82e78f 100644
--- a/arch/arm/dts/rk3506.dtsi
+++ b/arch/arm/dts/rk3506.dtsi
@@ -377,12 +377,14 @@
 			status = "disabled";
 		};
 
-		fspi: spi@ff488000 {
+		sfc: spi@ff488000 {
 			compatible = "rockchip,rk3506-fspi", "rockchip,sfc";
 			reg = <0xff488000 0x4000>;
 			interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&cru SCLK_FSPI>, <&cru HCLK_FSPI>;
 			clock-names = "clk_sfc", "hclk_sfc";
+			rockchip,sfc-no-dma;	/* XXX: rk-forge debug — SFC DMA corrupts reads (printf breaks DMA state), try PIO */
+			rockchip,max-dll = <0x17F>;	/* RK3506 SFC is VER_5; cap DLL cell scan (vendor value) */
 			#address-cells = <1>;
 			#size-cells = <0>;
 			status = "disabled";
-- 
2.55.0

