From 877128aecd0f14caecf7f85b75d68cbe062bd3e9 Mon Sep 17 00:00:00 2001
From: Jonas Karlman <jonas@kwiboo.se>
Date: Wed, 5 Feb 2025 01:24:07 +0000
Subject: [PATCH 9013/9034] rockchip: rk3506: Enable use of SPL_OPTEE_IMAGE

Vendor OP-TEE blob provides PSCI that is used to enable CPU cores on
RK3506. The OP-TEE blob is expected to be loaded and executed from
0x1000 and uses memory in the 0-1 MiB area of DRAM.

Add initial support for loading OP-TEE firmware on RK3506. Reserve the
first 1 MiB of DRAM for OP-TEE and use ROCKCHIP_SPL_RESERVE_IRAM to add
padding to the start of SPL text area to allow loading OP-TEE to 0x1000.

Signed-off-by: Austin Lane <vidplace7@gmail.com>
---
 arch/arm/mach-rockchip/Kconfig  | 4 ++++
 arch/arm/mach-rockchip/sdram.c  | 5 ++++-
 include/configs/rk3506_common.h | 1 +
 3 files changed, 9 insertions(+), 1 deletion(-)

diff --git a/arch/arm/mach-rockchip/Kconfig b/arch/arm/mach-rockchip/Kconfig
index 05fe7ac05f3..4b26bbb1d8a 100644
--- a/arch/arm/mach-rockchip/Kconfig
+++ b/arch/arm/mach-rockchip/Kconfig
@@ -322,6 +322,7 @@ config ROCKCHIP_RK3506
 	select BOARD_LATE_INIT
 	select DM_REGULATOR_FIXED
 	select DM_RESET
+	imply ARM_SMCCC if SPL_OPTEE_IMAGE
 	imply BOOTSTD_FULL
 	imply DM_RNG
 	imply ENV_RELOC_GD_ENV_ADDR
@@ -342,6 +343,7 @@ config ROCKCHIP_RK3506
 	imply SPL_FIT_SIGNATURE
 	imply SPL_LOAD_FIT
 	imply SPL_OF_CONTROL
+	imply SPL_OPTEE_IMAGE if SPL_FIT
 	imply SPL_PINCTRL
 	imply SPL_RAM
 	imply SPL_REGMAP
@@ -349,6 +351,7 @@ config ROCKCHIP_RK3506
 	imply SPL_SYSCON
 	imply SYS_ARCH_TIMER
 	imply SYSRESET
+	imply SYSRESET_PSCI if SPL_OPTEE_IMAGE
 	help
 	  The Rockchip RK3506 is a ARM-based SoC with a tri-core Cortex-A7.
 
@@ -566,6 +569,7 @@ config ROCKCHIP_STIMER_BASE
 
 config ROCKCHIP_SPL_RESERVE_IRAM
 	hex "Size of IRAM reserved in SPL"
+	default 0x40000 if ROCKCHIP_RK3506 && SPL_OPTEE_IMAGE
 	default 0x0
 	depends on SPL
 	help
diff --git a/arch/arm/mach-rockchip/sdram.c b/arch/arm/mach-rockchip/sdram.c
index 1fb01e1c4b1..0d5f66c1d35 100644
--- a/arch/arm/mach-rockchip/sdram.c
+++ b/arch/arm/mach-rockchip/sdram.c
@@ -311,7 +311,7 @@ int dram_init_banksize(void)
 		gd->bd->bi_dram[1].size = ram_top - gd->bd->bi_dram[1].start;
 	}
 #else
-#ifdef CONFIG_SPL_OPTEE_IMAGE
+#if defined(CONFIG_SPL_OPTEE_IMAGE) && !defined(CFG_SYS_SDRAM_RESERVE)
 	struct tos_parameter_t *tos_parameter;
 
 	tos_parameter = (struct tos_parameter_t *)(CFG_SYS_SDRAM_BASE +
@@ -334,6 +334,9 @@ int dram_init_banksize(void)
 	}
 #else
 	gd->bd->bi_dram[0].start = CFG_SYS_SDRAM_BASE;
+#ifdef CFG_SYS_SDRAM_RESERVE
+	gd->bd->bi_dram[0].start += CFG_SYS_SDRAM_RESERVE;
+#endif
 	gd->bd->bi_dram[0].size = top - gd->bd->bi_dram[0].start;
 #endif
 #endif
diff --git a/include/configs/rk3506_common.h b/include/configs/rk3506_common.h
index 5e4ef67289f..c008fee8211 100644
--- a/include/configs/rk3506_common.h
+++ b/include/configs/rk3506_common.h
@@ -11,6 +11,7 @@
 #define CFG_IRAM_BASE			0xfff80000
 
 #define CFG_SYS_SDRAM_BASE		0
+#define CFG_SYS_SDRAM_RESERVE		SZ_1M
 #define SDRAM_MAX_SIZE			0xc0000000
 
 #ifndef ROCKCHIP_DEVICE_SETTINGS
-- 
2.55.0

