From 57a5478dcf922e6fa31739b5828e0912485df91e Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Sun, 6 Sep 2026 02:25:44 +0800
Subject: [PATCH] rockchip: correct ubi mtd part offset

---
 arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand.dts | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand.dts b/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand.dts
index 5ce422bed28..4e5bc3945dc 100644
--- a/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand.dts
+++ b/arch/arm/dts/rk3506-vx-hd-rk3506g-iot-spinand.dts
@@ -21,13 +21,13 @@
 		#size-cells = <1>;
 		boot@0 {
 			label = "boot";
-			reg = <0x0000000 0x0100000>;
+			reg = <0x0000000 0x0200000>;
 			read-only;
 		};
 
-		ubi0@100000 {
+		ubi0@200000 {
 			label = "ubi";
-			reg = <0x0100000 0x0000000>;
+			reg = <0x0200000 0x0000000>;
 		};
 	};
 };
-- 
2.55.0

