From e53759a64bb2d84f666fb950ee21ac6641db30ee Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Sun, 6 Sep 2026 00:04:47 +0800
Subject: [PATCH] rockchip: correct RK3506's SRAM start address

---
 arch/arm/mach-rockchip/Kconfig             | 2 +-
 configs/vx-hd-rk3506-iot-spinand_defconfig | 1 -
 2 files changed, 1 insertion(+), 2 deletions(-)

diff --git a/arch/arm/mach-rockchip/Kconfig b/arch/arm/mach-rockchip/Kconfig
index a02c849b91b..c0459550b6c 100644
--- a/arch/arm/mach-rockchip/Kconfig
+++ b/arch/arm/mach-rockchip/Kconfig
@@ -713,7 +713,7 @@ config SPL_TEXT_BASE
 			      ROCKCHIP_RK3128 || ROCKCHIP_RK3188 || \
 			      ROCKCHIP_RK322X || ROCKCHIP_RV1108
 	default 0x40000000 if ROCKCHIP_RK3576
-	default 0x40000000 if ROCKCHIP_RK3506
+	default 0x00000000 if ROCKCHIP_RK3506
 	default 0x00000000
 
 config SPL_HAS_BSS_LINKER_SECTION
diff --git a/configs/vx-hd-rk3506-iot-spinand_defconfig b/configs/vx-hd-rk3506-iot-spinand_defconfig
index 7132428d1ee..134f05a6f71 100644
--- a/configs/vx-hd-rk3506-iot-spinand_defconfig
+++ b/configs/vx-hd-rk3506-iot-spinand_defconfig
@@ -60,7 +60,6 @@ CONFIG_LED_GPIO=y
 CONFIG_MMC_DW=y
 CONFIG_MMC_DW_ROCKCHIP=y
 CONFIG_DM_MTD=y
-CONFIG_MTD_RAW_NAND=y
 CONFIG_SYS_NAND_U_BOOT_LOCATIONS=y
 CONFIG_SYS_NAND_U_BOOT_OFFS=0x4000
 CONFIG_MTD_SPI_NAND=y
-- 
2.55.0

