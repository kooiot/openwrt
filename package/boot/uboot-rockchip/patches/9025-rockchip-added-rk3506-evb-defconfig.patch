From cf16df43dc443561ccbcf0bb6629126c3918ecc4 Mon Sep 17 00:00:00 2001
From: Dirk Chang <dirk@kooiot.com>
Date: Thu, 3 Sep 2026 16:26:52 +0800
Subject: [PATCH 9025/9034] rockchip: added rk3506 evb defconfig

---
 configs/evb-rk3506_defconfig | 52 ++++++++++++++++++++++++++++++++++++
 1 file changed, 52 insertions(+)
 create mode 100644 configs/evb-rk3506_defconfig

diff --git a/configs/evb-rk3506_defconfig b/configs/evb-rk3506_defconfig
new file mode 100644
index 00000000000..938af27c6d0
--- /dev/null
+++ b/configs/evb-rk3506_defconfig
@@ -0,0 +1,52 @@
+CONFIG_ARM=y
+CONFIG_SKIP_LOWLEVEL_INIT=y
+CONFIG_COUNTER_FREQUENCY=24000000
+CONFIG_ARCH_ROCKCHIP=y
+CONFIG_DEFAULT_DEVICE_TREE="rk3506-evb"
+CONFIG_ROCKCHIP_RK3506=y
+CONFIG_SYS_LOAD_ADDR=0xc00800
+CONFIG_DEBUG_UART_BASE=0xff0a0000
+CONFIG_DEBUG_UART_CLOCK=24000000
+CONFIG_DEBUG_UART=y
+# CONFIG_BOOTMETH_VBE is not set
+CONFIG_DEFAULT_FDT_FILE="rockchip/rk3506-evb.dtb"
+# CONFIG_DISPLAY_CPUINFO is not set
+CONFIG_SPL_MAX_SIZE=0x40000
+# CONFIG_SPL_RAW_IMAGE_SUPPORT is not set
+CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x2000
+CONFIG_CMD_MEMINFO=y
+CONFIG_CMD_MEMINFO_MAP=y
+CONFIG_CMD_GPIO=y
+CONFIG_CMD_GPT=y
+CONFIG_CMD_MISC=y
+CONFIG_CMD_MMC=y
+# CONFIG_CMD_SETEXPR is not set
+CONFIG_CMD_RNG=y
+# CONFIG_SPL_DOS_PARTITION is not set
+# CONFIG_OF_UPSTREAM is not set
+# CONFIG_TOOLS_MKEFICAPSULE is not set
+CONFIG_OF_SPL_REMOVE_PROPS="clock-names interrupt-parent assigned-clocks assigned-clock-rates assigned-clock-parents"
+CONFIG_NO_NET=y
+# CONFIG_ADC is not set
+CONFIG_ROCKCHIP_GPIO=y
+CONFIG_MMC_DW=y
+CONFIG_MMC_DW_ROCKCHIP=y
+CONFIG_BAUDRATE=1500000
+CONFIG_DEBUG_UART_SHIFT=2
+CONFIG_SYS_NS16550_MEM32=y
+CONFIG_ERRNO_STR=y
+
+# SPI SFC controller + SPI NAND (Winbond W25N04KV, 512MB) — boot from on-board NAND
+CONFIG_DM_SPI=y
+CONFIG_ROCKCHIP_SFC=y
+CONFIG_MTD=y
+CONFIG_DM_MTD=y
+CONFIG_MTD_SPI_NAND=y
+CONFIG_CMD_MTD=y
+# kernel boot
+CONFIG_FIT=y
+CONFIG_CMD_BOOTM=y
+CONFIG_CMD_BOOTZ=y
+CONFIG_SYS_BOOTM_LEN=0x2000000
+# NAND partition: boot = 24MB @ sector 0xBA00 (= byte 0x1740000), holds kernel FIT
+CONFIG_MTDPARTS_DEFAULT="mtdparts=spi-nand0:24m@0x1740000(boot)"
-- 
2.55.0

