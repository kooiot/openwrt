 }
 
@@ -1153,6 +1160,10 @@ static int spinand_init(struct spinand_device *spinand)
 
 	mtd->oobavail = ret;
 
+#if !defined(CONFIG_SPL_BUILD) && CONFIG_IS_ENABLED(MTD_NAND_BBT_USING_FLASH)
+	nanddev_scan_bbt_in_flash(nand);
+#endif
+
 	return 0;
 
 err_cleanup_nanddev:
diff --git a/include/linux/mtd/bbt_store.h b/include/linux/mtd/bbt_store.h
new file mode 100644
index 00000000000..09b5de59330
--- /dev/null
+++ b/include/linux/mtd/bbt_store.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Copyright (c) 2021 Rockchip Electronics Co., Ltd.
+ *
+ */
+
+#ifndef __BBT_STORE_H
+#define __BBT_STORE_H
+
+#include <linux/mtd/nand.h>
+
+#ifdef CONFIG_MTD_NAND_BBT_USING_FLASH
+int nanddev_scan_bbt_in_flash(struct nand_device *nand);
+int nanddev_bbt_in_flash_update(struct nand_device *nand);
+#else
+static inline int nanddev_scan_bbt_in_flash(struct nand_device *nand)
+{
+	return 0;
+}
+static inline int nanddev_bbt_in_flash_update(struct nand_device *nand)
+{
+	return 0;
+}
+#endif
+
+#endif
diff --git a/include/linux/mtd/nand.h b/include/linux/mtd/nand.h
index 651f8706df5..18a14eff886 100644
