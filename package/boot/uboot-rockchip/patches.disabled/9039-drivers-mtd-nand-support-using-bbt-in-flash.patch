 #include <linux/bug.h>
+#include <linux/mtd/bbt_store.h>
 #include <linux/mtd/spinand.h>
 #include <linux/printk.h>
 #endif
@@ -751,6 +753,11 @@ static int spinand_mtd_block_markbad(struct mtd_info *mtd, loff_t offs)
